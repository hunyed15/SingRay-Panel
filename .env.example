# ---------- 必填 ----------
PANEL_HOST=127.0.0.1
PANEL_PORT=3000
PANEL_DB=./data/panel.db

# 两个密钥都必须换成真实随机值:openssl rand -hex 32
# 启动时会校验:仍是默认值或下面这个示例占位符 → 直接拒绝启动(与 PANEL_HOST 无关,
# nginx 反代到 127.0.0.1 的部署同样要求)。用默认串可以离线伪造管理员令牌。
PANEL_JWT_SECRET=change-me-openssl-rand-hex-32
# 字段加密密钥(节点凭据/SSH 私钥落库加密)。从旧面板迁移时必须设为旧面板的 APP_SECRET,
# 否则旧密文解不开;一旦变更,已加密的凭据需要重新录入。
PANEL_APP_SECRET=change-me-openssl-rand-hex-32

# 初始管理员(仅首次创建时使用)。口令留空 = 随机生成 16 位并只打印一次,
# 不再有 admin888 这类默认口令。
PANEL_ADMIN_USER=admin
PANEL_ADMIN_PASSWORD=

# ---------- 可选 ----------
# 备份:目录(空 = 数据库同目录 backups/)、保留份数、每日执行小时(本地时区)
# PANEL_BACKUP_DIR=
# PANEL_BACKUP_RETENTION=14
# PANEL_BACKUP_HOUR=4
# 健康检查间隔(分钟)
# PANEL_HEALTH_INTERVAL=5
# ACME DNS-01(Cloudflare API Token):配置后签证书不需要 80 端口;面板设置里填的值优先。
# 注意:面板设置里保存的 Token 目前以明文存于 settings 表并会进入备份,备份文件请按凭据对待。
# PANEL_CF_TOKEN=
# Telegram 告警(面板设置里填的值优先)
# TG_BOT_TOKEN=
# TG_CHAT_ID=
# 自定义 .env 路径(默认仓库根目录 .env)
# PANEL_ENV_FILE=
# 核心版本(缺省 latest)
# SINGBOX_VERSION=latest
# XRAY_VERSION=latest
