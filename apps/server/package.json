{
  "name": "@singray/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && node -e \"const fs=require('fs');fs.cpSync('src/db/migrations','dist/db/migrations',{recursive:true})\"",
    "start": "node dist/index.js",
    "restore": "tsx src/cli/restore.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/jwt": "9.1.0",
    "@fastify/rate-limit": "11.2.0",
    "bcryptjs": "3.0.3",
    "fastify": "5.12.4",
    "ssh2": "1.17.0",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "@types/ssh2": "1.15.6",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
